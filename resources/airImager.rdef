resource vector_icon { import "airImager.hvif" };
resource app_signature "application/x-vnd.airos-airImager";
resource app_flags B_SINGLE_LAUNCH;
resource app_version {
	major = 1, middle = 0, minor = 0, variety = B_APPV_FINAL, internal = 1,
	short_info = "airImager",
	long_info = "Writes air/OS images (.iso.xz, .img.xz, .iso, .img) to USB sticks and SD cards, and verifies them. Never writes the drive air/OS runs from."
};
resource file_types message {
	"types" = "application/x-xz",
	"types" = "application/x-cd-image",
	"types" = "application/x-bfs-image",
	"types" = "application/octet-stream"
};

// The pictures of the Image and Drive steps (the Write step shows the
// application's icon).
resource(1, "image") #'VICN' import "image.hvif";
resource(2, "drive") #'VICN' import "drive.hvif";
